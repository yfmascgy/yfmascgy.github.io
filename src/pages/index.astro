---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, publications, updates } from '../data/site';

const featuredWork = publications.filter((publication) => publication.featured).slice(0, 3);
---

<BaseLayout>
    <section class="hero shell" transition:animate="fade">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Engineering leader · researcher · builder</p>
        <h1>Engineering the global network that <em>keeps Uber moving.</em></h1>
        <p class="lede">I’m Yunfei Ma, a {profile.currentRole} at Uber. {profile.leadership}</p>
        <p class="charter">{profile.networkCharter}</p>
        <div class="role-scope" aria-label="Networking organization responsibilities">
          <article><span>Edge Networking</span><p>{profile.edgeScope}</p></article>
          <article><span>Mobile Networking</span><p>{profile.mobileScope}</p></article>
          <article><span>Autonomous Vehicle Networking</span><p>{profile.autonomousVehicleScope}</p></article>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href="/research">Explore my work <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="https://scholar.google.com/citations?user=tWda9dcAAAAJ&hl=en&oi=ao">Google Scholar <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="portrait-card" aria-label="Portrait and current role">
        <div class="portrait-frame" data-shape="round">
          <img src="/images/yunfei_bio.jpg" alt="Yunfei Ma" width="250" height="250" />
        </div>
        <div class="portrait-meta">
          <div>
            <span>Currently</span>
            <strong>Uber</strong>
          </div>
          <div>
            <span>Based in</span>
            <strong>Sunnyvale, California</strong>
          </div>
        </div>
      </aside>
    </section>

    <section class="signal-strip" aria-label="Areas of focus">
      <div class="shell signal-list">
        <span>Global networking</span>
        <i></i>
        <span>Multi-cloud</span>
        <i></i>
        <span>Vehicle-to-cloud</span>
        <i></i>
        <span>Network security</span>
      </div>
    </section>

    <section class="section shell" aria-labelledby="featured-heading">
      <div class="section-heading">
        <div>
          <p class="kicker">Selected work</p>
          <h2 id="featured-heading">Research that moved from paper to production.</h2>
        </div>
        <a class="text-link" href="/research">View all research <span aria-hidden="true">→</span></a>
      </div>

      <div class="work-grid">
        {featuredWork.map((work, index) => (
          <a class="work-card" href={work.href ?? '/research'} style={`--delay: ${index * 80}ms`}>
            <div class="work-meta"><span>{work.venue}</span><span>{work.year}</span></div>
            <h3>{work.title.split(':')[0]}</h3>
            <p>{work.description}</p>
            <span class="card-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="dark-section">
      <div class="shell focus-grid">
        <div>
          <p class="kicker kicker-light">What I work on</p>
          <h2>Reliable, secure connectivity from cloud edge to moving vehicles.</h2>
        </div>
        <div class="focus-list">
          <article><span>01</span><div><h3>Edge Networking</h3><p>{profile.edgeFocus}</p></div></article>
          <article><span>02</span><div><h3>Mobile Networking</h3><p>Owning the networking stack, libraries, and observability infrastructure across Uber’s iOS and Android apps.</p></div></article>
          <article><span>03</span><div><h3>Autonomous Vehicle Networking</h3><p>{profile.autonomousVehicleScope}</p></div></article>
          <article><span>04</span><div><h3>Multipath QUIC</h3><p>{profile.xlinkImpact} {profile.ietfImpact}</p></div></article>
          <article><span>05</span><div><h3>Wireless sensing</h3><p>Extending connectivity to battery-free devices, robots, and miniature medical systems.</p></div></article>
        </div>
      </div>
    </section>

    <section class="section shell">
      <div class="section-heading">
        <div><p class="kicker">Professional service</p><h2>Contributing to the systems and networking community.</h2></div>
        <a class="text-link" href="/updates">View news archive <span aria-hidden="true">→</span></a>
      </div>
      <div class="updates-preview">
        {updates.slice(0, 3).map((update) => (
          <article class="update-row">
            <span>{update.year}</span>
            <p>{update.title}</p>
            {update.href ? <a href={update.href} aria-label={`Read more: ${update.title}`}>↗</a> : <i></i>}
          </article>
        ))}
      </div>
    </section>

    <section class="profile-cta shell">
      <p class="kicker">Beyond the systems</p>
      <div><h2>Engineer, researcher, and team builder.</h2><p>My work connects academic ideas with production systems—from Cornell and MIT to Alibaba and Uber.</p></div>
      <a class="button button-primary" href="/about">Read my story <span aria-hidden="true">→</span></a>
    </section>
</BaseLayout>
