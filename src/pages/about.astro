---
import BaseLayout from '../layouts/BaseLayout.astro';
import { awards, committeeService, patents, profile } from '../data/site';
---

<BaseLayout title="About — Yunfei Ma" description="About Yunfei Ma, a Sr. Engineering Manager at Uber leading Mobile & Edge Networking, and a researcher based in Sunnyvale, California.">
  <section class="page-hero about-hero shell">
    <div>
      <p class="eyebrow"><span></span> About</p>
      <h1>Engineering with <em>range and depth.</em></h1>
    </div>
    <div class="about-portrait" data-shape="round"><img src="/images/yunfei_bio.jpg" alt="Yunfei Ma" width="250" height="250" /></div>
  </section>

  <section class="bio-section shell">
    <aside><p>Now</p><strong>{profile.currentRole}</strong><span>Uber · Sunnyvale, California</span></aside>
    <div class="bio-copy">
      <p>{profile.leadership}</p>
      <p>{profile.edgeScope}</p>
      <p>{profile.mobileScope}</p>
      <p>Previously, I was a researcher and senior manager at Alibaba Group in Sunnyvale, where I helped build mobile and wide-area networking technologies for Alibaba’s global infrastructure across commerce, video conferencing, and cloud services.</p>
      <div class="experience-highlights" aria-label="Multipath QUIC experience">
        <article><span>Production impact</span><strong>{profile.xlinkImpact}</strong></article>
        <article><span>Open standard</span><strong>{profile.ietfImpact}</strong></article>
      </div>
      <p>Before industry, I was a postdoctoral associate in the Signal Kinetics group at MIT Media Lab, supervised by Professor Fadel Adib. I earned my Ph.D. in Electrical and Computer Engineering from Cornell University, advised by Professor Edwin C. Kan, and my B.Sc. in Electrical Engineering from the University of Science and Technology of China.</p>
      <div class="bio-actions"><a class="button button-primary" href="/Yunfei_CV.pdf">Download CV <span>↗</span></a><a class="button button-secondary" href="https://scholar.google.com/citations?user=tWda9dcAAAAJ&hl=en&oi=ao">Google Scholar <span>↗</span></a></div>
    </div>
  </section>

  <section class="career-section dark-section">
    <div class="shell">
      <p class="kicker kicker-light">Journey</p>
      <div class="career-track">
        <article><span>Present</span><h3>Uber</h3><p>Mobile & Edge Networking</p></article>
        <article><span>Industry</span><h3>Alibaba</h3><p>Global network infrastructure</p></article>
        <article><span>Research</span><h3>MIT Media Lab</h3><p>Signal Kinetics</p></article>
        <article><span>Ph.D.</span><h3>Cornell</h3><p>Electrical & Computer Engineering</p></article>
        <article><span>B.Sc.</span><h3>USTC</h3><p>Electrical Engineering</p></article>
      </div>
    </div>
  </section>

  <section class="section shell split-section">
    <div>
      <p class="kicker">Recognition</p>
      <h2>Awards</h2>
      <div class="award-list">
        {awards.map((award) => <article><span>{award.year}</span><div><strong>{award.title}</strong>{award.detail && <small>{award.detail}</small>}</div></article>)}
      </div>
    </div>
    <div>
      <p class="kicker">Invention</p>
      <h2>Patents</h2>
      <ol class="patent-list">{patents.map((patent) => <li>{patent}</li>)}</ol>
    </div>
  </section>

  <section class="service-section shell" aria-labelledby="service-heading">
    <div class="service-intro">
      <p class="kicker">Academic service</p>
      <h2 id="service-heading">Committee service</h2>
      <p>Supporting the systems and networking research community through technical program committees.</p>
    </div>
    <ol class="service-list">
      {committeeService.map((service) => (
        <li>
          <time>{service.year}</time>
          <div><strong>{service.organization}</strong><span>{service.role}</span></div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
