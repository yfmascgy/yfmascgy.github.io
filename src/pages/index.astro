---
import BaseLayout from '../layouts/BaseLayout.astro';
import { awards, committeeService, profile, publications } from '../data/site';

const featuredWork = publications.filter((publication) => publication.featured).slice(0, 3);
const experience = [
  { organization: 'Uber', detail: 'Sr. Engineering Manager · Mobile & Edge Networking' },
  { organization: 'Alibaba', detail: 'Senior Manager · Alibaba Cloud' },
  { organization: 'MIT Media Lab', detail: 'Postdoctoral Associate · Signal Kinetics' },
  { organization: 'Cornell University', detail: 'Ph.D. · Electrical & Computer Engineering' },
] as const;
---

<BaseLayout>
    <section class="hero shell" transition:animate="fade">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Networks · systems · engineering leadership</p>
        <h1>Yunfei Ma</h1>
        <p class="role-line">{profile.currentRole} · Uber</p>
        <p class="lede">{profile.leadership}</p>
        <p class="charter">{profile.networkCharter}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/research">Selected research <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="https://scholar.google.com/citations?user=tWda9dcAAAAJ&hl=en&oi=ao">Google Scholar <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="portrait-card" aria-label="Portrait of Yunfei Ma">
        <div class="portrait-frame" data-shape="round">
          <img src="/images/yunfei_bio.jpg" alt="Yunfei Ma" width="250" height="250" />
        </div>
        <p class="portrait-caption">Sunnyvale, California</p>
      </aside>
    </section>

    <section class="scope-section shell" aria-labelledby="scope-heading">
      <div class="scope-heading">
        <p class="kicker">Current scope</p>
        <h2 id="scope-heading">Global connectivity at Uber</h2>
      </div>
      <div class="role-scope" aria-label="Networking organization responsibilities">
        <article><span>Edge Networking</span><p>{profile.edgeScope}</p></article>
        <article><span>Mobile Networking</span><p>{profile.mobileScope}</p></article>
        <article><span>Autonomous Vehicle Networking</span><p>{profile.autonomousVehicleScope}</p></article>
      </div>
    </section>

    <section class="section shell" aria-labelledby="featured-heading">
      <div class="section-heading">
        <div>
          <p class="kicker">Selected work</p>
          <h2 id="featured-heading">Systems and protocols</h2>
        </div>
        <a class="text-link" href="/research">View all research <span aria-hidden="true">→</span></a>
      </div>

      <div class="work-grid">
        {featuredWork.map((work, index) => (
          <a class="work-card" href={work.href ?? '/research'} style={`--delay: ${index * 80}ms`}>
            <div class="work-meta"><span>{work.venue}</span><span>{work.year}</span></div>
            <h3>{work.title.split(':')[0]}</h3>
            <p>{work.description}</p>
            <span class="card-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section shell evidence-section" aria-labelledby="evidence-heading">
      <div class="section-heading compact-heading">
        <div><p class="kicker">Experience & service</p><h2 id="evidence-heading">Selected record</h2></div>
        <a class="text-link" href="/about">Full profile <span aria-hidden="true">→</span></a>
      </div>
      <div class="evidence-grid">
        <section aria-labelledby="experience-heading">
          <h3 id="experience-heading">Experience</h3>
          <div class="evidence-list">
            {experience.map((item) => <article><strong>{item.organization}</strong><span>{item.detail}</span></article>)}
          </div>
        </section>
        <section aria-labelledby="recognition-heading">
          <h3 id="recognition-heading">Recognition</h3>
          <div class="evidence-list">
            {awards.slice(0, 4).map((award) => <article><strong>{award.year}</strong><span>{award.title}{award.detail && ` · ${award.detail}`}</span></article>)}
          </div>
        </section>
        <section aria-labelledby="service-preview-heading">
          <h3 id="service-preview-heading">Academic service</h3>
          <div class="evidence-list">
            {committeeService.slice(0, 4).map((service) => <article><strong>{service.year}</strong><span>{service.organization} · {service.role}</span></article>)}
          </div>
        </section>
      </div>
    </section>
</BaseLayout>
